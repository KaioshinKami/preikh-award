{
  "name": "preikh-award-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env src/server.ts",
    "migrate": "node --env-file=.env src/db/migrate.ts",
    "seed": "node --env-file=.env src/db/seed.ts",
    "create-admin": "node --env-file=.env src/cli/create-admin.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --env-file=.env --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1"
  }
}
