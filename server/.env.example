# Copy to server/.env and fill in. server/.env is git-ignored.

# Local PostgreSQL 18. The database is created by `npm run migrate` if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/preikh_award

# Long random string (at least 32 characters). Generate one with:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

PORT=4000
NODE_ENV=development
